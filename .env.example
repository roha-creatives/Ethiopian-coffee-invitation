# Public address of the site (used in share previews). Example: https://first-pour.vercel.app
NEXT_PUBLIC_SITE_URL=

# --- Guest list (Google Sheet) ---
# The whole JSON key file of the Google service account, pasted as one value.
GOOGLE_SERVICE_ACCOUNT_JSON=
# From the sheet URL: https://docs.google.com/spreadsheets/d/<THIS PART>/edit
GOOGLE_SHEET_ID=
# Name of the tab RSVPs are written to (the tab must exist)
GOOGLE_SHEET_TAB=RSVPs

# --- Gate check-in ---
# PIN gate staff type once at /gate (6+ characters; letters allowed)
GATE_PIN=
# Optional: any long random string; signing out every staff phone = change it
GATE_SECRET=
